# Large source art in newly imported packages. Runtime files keep their normal paths.
# Existing stable art history is not rewritten; install Git LFS before cloning/pulling.
[attr]unity-lfs filter=lfs diff=lfs merge=lfs -text

# Unity writes empty serialized values with a trailing space.
*.unity whitespace=-blank-at-eol
*.scene whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.controller whitespace=-blank-at-eol
*.anim whitespace=-blank-at-eol
*.csv whitespace=cr-at-eol
*.md whitespace=cr-at-eol
devtools/**/*.cs.txt whitespace=cr-at-eol

